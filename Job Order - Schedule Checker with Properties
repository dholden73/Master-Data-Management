cleanup AS (
    SELECT *
    FROM (
        SELECT
            j.work_schedule_id,
            j.work_request_id,
            j.work_master_id,
            j.job_order_end_time,    -- used to pick the latest cleanup bogging job
            j.source_material_lot_id,
            j.source_material_definition_id,
            j.dest_material_lot_id,
            j.dest_material_definition_id,
            j.tonnes,
            j.au_gpt,
            j.au_mass_grams,
            ROW_NUMBER() OVER (
                PARTITION BY j.work_schedule_id, j.work_request_id
                ORDER BY j.job_order_end_time DESC NULLS LAST, j.job_order_id DESC
            ) AS rn
        FROM joined j
        WHERE j.work_master_id = 'Cleanup Bogging'
    ) x
    WHERE rn = 1
)
