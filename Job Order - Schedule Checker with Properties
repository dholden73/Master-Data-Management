WITH DM_jobOrder AS (
    SELECT
        job_order_id,
        description,
        start_time,
        end_time,
        work_type,
        work_master_id,
        work_schedule_id,
        work_schedule_work_type,
        work_schedule_start_time,
        work_schedule_end_time,
        work_schedule_state,
        work_request_id,
        work_request_start_time,
        work_request_end_time,
        source_hierarchy_scope_path,
        source_material_lot_id,
        source_material_definition_id,
        dest_hierarchy_scope_path,
        dest_material_lot_id,
        dest_material_definition_id,
        expenditure,
        dev_type,
        mass
    FROM datamart.job_order
    WHERE work_schedule_id LIKE 'W%'
),
actuals AS (
    SELECT
        jr.job_order_id,
        SUM(jr.mass) AS tonnes,
        AVG(ml.au_gpt) AS au_gpt,  -- NOTE: this is simple average; change to weighted if needed
        SUM(jr.mass * ml.au_gpt) AS au_mass_grams,
        MAX(jr.end_time) as end_time
    FROM datamart.job_response jr
    LEFT JOIN LATERAL (
        SELECT
            ml.au_gpt,
            ml.au_mass
        FROM datamart.material_lot ml
        WHERE ml.material_lot_id = jr.source_material_lot_id
          AND ml.effective_from_time <= jr.end_time
          AND (ml.effective_to_time IS NULL OR ml.effective_to_time > jr.end_time)
        ORDER BY ml.effective_from_time DESC  
        LIMIT 1
    ) ml ON TRUE
    GROUP BY
        jr.job_order_id
),
current_records_sk AS (
    SELECT DISTINCT ON (ma.material_lot_ids[1]) 
        ma.material_lot_ids[1] AS material_lot_id,
        ma.material_actual_sk
    FROM dw.material_actual ma
    WHERE ma.source_system = 'GCMSdh'
      AND ma.material_use ILIKE 'inventoried'
      -- optional but usually good:
      AND COALESCE(ma.is_deleted, false) = false
    ORDER BY 
        ma.material_lot_ids[1],  -- DISTINCT ON key
        -- Prefer rows where MD + operational_location are NOT NULL
        (ma.material_definition_ids[1] IS NULL 
         OR ma.operational_location IS NULL),
        ma.record_time DESC,
        ma.material_actual_sk DESC
),
DH_mine_sources AS	(
	SELECT 
	    --x.material_actual_sk,
	    x.material_lot_ids[1] AS material_lot_id,
	    --hs.equipment_path AS hierarchy_scope,
	    --x.material_definition_ids[1] AS material_definition_id,
	    --x.main_quantity_sk,
	    --x.main_quantity_key,
	    x.main_quantity_value_dec as mass_inventoried,
	    --x.material_use,
	    --x.main_quantity_uom,
	    --x.operational_location,
	    --x.operational_location_type,
	    --x.is_deleted,
	    x.record_time, ----> need the latest version
	    --x.source_system,
	    --x.ingestion_reference_sk,
	    au.value::numeric AS au_gpt_inventoried,
	    COALESCE(dev.value, '0') AS DEV_inventoried,
	    COALESCE(sto.value, '0') AS STO_inventoried,
	    open_date.value::date AS opening_date_inventoried
	FROM current_records_sk sk
	JOIN dw.material_actual x 
	  ON x.material_actual_sk = sk.material_actual_sk
	--LEFT JOIN dw.hierarchy_scope hs 
	--  ON x.hierarchy_scope ~~* hs.id
	LEFT JOIN dw.property au 
	  ON au.entity_sk = x.material_actual_sk AND au.id = 'Au gpt'
	LEFT JOIN dw.property dev 
	  ON dev.entity_sk = x.material_actual_sk AND dev.id = 'DEV'
	LEFT JOIN dw.property sto 
	  ON sto.entity_sk = x.material_actual_sk AND sto.id = 'STO'
	LEFT JOIN dw.property open_date 
	  ON open_date.entity_sk = x.material_actual_sk AND open_date.id = 'Opening Date'
	),
DSS_blasting_src AS (
