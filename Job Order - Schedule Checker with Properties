  WHEN b.work_master_id IN ('Dev Bogging','Prod Remote Bogging')
   AND b.dest_material_lot_id IS NOT NULL
   AND NOT (b.dest_material_lot_id ~* '(_rom$|_waste$)')
  THEN true
  ELSE false
END AS bogging_dest_red,
