	CASE
  WHEN bl.work_master_id IN ('Dev Blasting','Prod Blasting')
   AND bl.source_material_lot_id IS NOT NULL
   AND NOT (bl.source_material_lot_id ~* '(_[0-9]{3}$|_p[0-9]+_[0-9]+$|_Insitu$)')
  THEN true
  ELSE false
