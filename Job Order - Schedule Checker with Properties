joined AS (
    SELECT
        ws.work_schedule_id,
        ws.work_request_id,
        ws.work_schedule_start_time as schedule_start,
        ws.work_schedule_end_time as schedule_end,
        ws.work_request_start_time AS request_start_time,
        ws.work_request_end_time AS request_end_time,
        ws.job_order_id,
        ws.end_time AS job_order_end_time,   -- used to pick the latest cleanup bogging job
        ws.work_master_id,
        ws.source_material_lot_id,
        ws.source_material_definition_id,
        ws.dest_material_lot_id,
        ws.dest_material_definition_id,
        a.tonnes,
        a.au_gpt,
        a.au_mass_grams,
        a.end_time
    FROM DM_jobOrder ws
    LEFT JOIN actuals a
        ON ws.job_order_id = a.job_order_id
        and a.end_time between ws.work_schedule_start_time and ws.work_schedule_end_time
),
blasting AS (
    SELECT
        j.work_schedule_id,
        j.work_request_id,
        j.request_start_time,
        j.request_end_time,
        j.schedule_start,
        j.schedule_end,
        j.end_time,
        j.work_master_id,
        j.source_material_lot_id,
        j.source_material_definition_id,
        j.dest_material_lot_id,
        j.dest_material_definition_id,
        j.tonnes,
        j.au_gpt,
        j.au_mass_grams
    FROM joined j
    WHERE j.work_master_id IN ('Dev Blasting', 'Prod Blasting')
),
bogging AS (
    SELECT
        j.work_schedule_id,
        j.work_request_id,
        j.work_master_id,
        j.source_material_lot_id,
        j.source_material_definition_id,
        j.dest_material_lot_id,
        j.dest_material_definition_id,
        j.tonnes,
        j.au_gpt,
        j.au_mass_grams
    FROM joined j
    WHERE j.work_master_id IN ('Dev Bogging', 'Prod Bogging')
),
extraction AS (
