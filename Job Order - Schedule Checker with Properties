  WHEN e.work_master_id IN ('Prod Extraction', 'Dev Extraction')
   AND e.dest_material_lot_id IS NOT NULL
   AND NOT (e.dest_material_lot_id ~* '(_rom$|_waste$|_paste waste$)')
