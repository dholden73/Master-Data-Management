  WHEN c.work_master_id ILIKE 'Cleanup Bogging'
   AND c.source_material_lot_id IS NOT NULL
   AND NOT (c.source_material_lot_id ~* '([0-9]{3}$)')
  THEN true
  ELSE false
END AS cleanup_source_red,
CASE
  WHEN c.work_master_id = 'Cleanup Bogging'
   AND c.dest_material_lot_id IS NOT NULL
   AND NOT (c.dest_material_lot_id ~* '(_waste$|_paste waste$)')
  THEN true
  ELSE false
END AS cleanup_dest_red
FROM blasting bl
LEFT JOIN bogging b
    ON bl.work_schedule_id = b.work_schedule_id
   AND bl.work_request_id  = b.work_request_id
LEFT JOIN extraction e
    ON bl.work_schedule_id = e.work_schedule_id
   AND bl.work_request_id  = e.work_request_id
LEFT JOIN cleanup c
    ON bl.work_schedule_id = c.work_schedule_id
   AND bl.work_request_id  = c.work_request_id
left join DH_mine_sources dh
	on bl.source_material_lot_id = dh.material_lot_id
left join DSS_blasting_src dssBl_src
	on bl.source_material_lot_id = dssBl_src.material_lot_id
	and dssBl_src.schedule_id = bl.work_schedule_id
left join DSS_blasting_dest dssBl_dest
	on bl.source_material_lot_id = dssBl_dest.material_lot_id
	and dssBl_dest.schedule_id = bl.work_schedule_id
left join DSS_bogging_src dssB_src
	on bl.source_material_lot_id = dssB_src.material_lot_id
	and dssB_src.schedule_id = bl.work_schedule_id
left join DSS_bogging_dest dssB_dest
	on bl.source_material_lot_id = dssB_dest.material_lot_id
	and dssB_dest.schedule_id = bl.work_schedule_id
left join DSS_extraction_src dsse_src
	on bl.source_material_lot_id = dsse_src.material_lot_id
	and dsse_src.schedule_id = bl.work_schedule_id
left join DSS_extraction_dest dsse_dest
	on bl.source_material_lot_id = dsse_dest.material_lot_id
	and dsse_dest.schedule_id = bl.work_schedule_id	
left join DSS_cleanup_src dsscl_src
	on bl.source_material_lot_id = dsscl_src.material_lot_id
	and dsse_src.schedule_id = bl.work_schedule_id
left join DSS_cleanup_dest dsscl_dest
	on bl.source_material_lot_id = dsscl_dest.material_lot_id
	and dsscl_dest.schedule_id = bl.work_schedule_id
